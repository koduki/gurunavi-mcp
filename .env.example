NODE_ENV=development
SERVICE_MODE=all
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
GURUNAVI_BASE_URL=https://r.gnavi.co.jp
BROWSER_WORKER_URL=
BROWSER_WORKER_AUDIENCE=
BROWSER_INTERACTION_BASE_URL=
BROWSER_INVOKER_EMAIL=
FIRESTORE_DATABASE_ID=(default)
GOOGLE_CLOUD_PROJECT=
KMS_KEY_NAME=
CLOUD_TASKS_QUEUE=gurunavi-reservation-status
CLOUD_TASKS_LOCATION=asia-northeast1
TASKS_TARGET_URL=
TASKS_INVOKER_EMAIL=
ALLOWED_EMAILS=master@example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-bytes
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
INTERACTION_TOKEN_TTL_SECONDS=900
RESERVATION_SUBMIT_ENABLED=false
AUTH_DISABLED=false
GURUNAVI_MIN_REQUEST_INTERVAL_MS=2000
GURUNAVI_NAVIGATION_TIMEOUT_MS=30000
LOG_LEVEL=info
