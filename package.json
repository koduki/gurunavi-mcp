{
  "name": "gurunavi-mcp",
  "version": "0.1.0",
  "description": "Browser-backed semantic MCP proxy for Rakuten Gurunavi",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "@google-cloud/kms": "^5.7.0",
    "@google-cloud/tasks": "^6.3.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright": "^1.62.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.0",
    "hcl2-parser": "^1.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
}
